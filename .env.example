# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Path to the organisers' data folder (kept out of git)
DATA_DIR=./data
PATIENT_ID=patient-0000-0001

# Models (see docs/PLAN.md)
EXTRACT_MODEL=claude-opus-5-5
PARSE_MODEL=claude-haiku-5-5

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional LLM request parser (engine/llm.py). Off unless SECOND_LOOK_LLM=1; the rule-based matcher
# always works on its own and the LLM only proposes role/task IDs that code validates.
SECOND_LOOK_LLM=0
# openai = any OpenAI-compatible API (Groq: https://api.groq.com/openai/v1, xAI: https://api.x.ai/v1)
SECOND_LOOK_LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Tested on Groq (eval/parser_eval.py): openai/gpt-oss-120b routed all 15 unseen situations without the
# general fallback and kept 20/22 hold-out cases; reasoning effort "low" keeps it under ~0.8 s.
SECOND_LOOK_LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
