  "tnm":               {"label": "TNM stage and grade",                  "types": ["finding"],                 "concepts": ["tnm"],                   "answer": "latest"},
  "receptors":         {"label": "Receptor status",                      "types": ["finding"],                 "concepts": ["er", "pr", "her2"],      "answer": "latest"},
  "ki67":              {"label": "Ki-67",                                "types": ["finding"],                 "concepts": ["ki67"],                  "answer": "latest"},
  "lymph_nodes":       {"label": "Lymph node findings",                  "types": ["finding"],                 "concepts": ["lymph_nodes"],           "answer": "all"},
  "tumour_board":      {"label": "Tumour board recommendation and date", "types": ["plan", "recommendation"],  "concepts": ["tumour_board", "surgery_plan"], "answer": "latest"},
  "prior_episodes":    {"label": "Similar episodes before and cause",    "types": ["history", "diagnosis"],    "concepts": ["amaurosis_fugax", "hypertensive_crisis"], "answer": "all"},
